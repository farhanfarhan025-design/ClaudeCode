# (see AI-Agent-System/memory/lessons.md L-003).
out/
*.xlsx
!AI-Agent-System/scripts/examples/*.json

__pycache__/
*.pyc
.DS_Store

# Quote outcome log is operational data (D-001) — tool is tracked, data is not.
AI-Agent-System/logs/*.csv
